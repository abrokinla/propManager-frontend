      "title": "List Your Property",
      "desc": "Add your property details, set rent prices, configure units, and publish your listing — all in minutes."
    },
    "step2": {
      "title": "Invite Tenants",
      "desc": "Send automated invitations. Tenants create their own profiles, submit payments, and sign agreements digitally."
    },
    "step3": {
      "title": "Manage from One Dashboard",
      "desc": "Track rent collection, approve maintenance requests, verify signed documents, and get real-time notifications."
    }
