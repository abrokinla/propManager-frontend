  "Features": {
    "badge": "Features",
    "title": "Everything you need to manage properties",
    "subtitle": "From listing to lease, PropManager gives you the tools to run your property business efficiently.",
    "management": {
      "title": "Property Management",
      "desc": "Track properties, units, and tenants from a single dashboard. Organize by location, status, and rent cycle."
    },
    "tenantPortal": {
      "title": "Tenant Portal",
      "desc": "Tenants get a self-service dashboard to view agreements, pay rent, request maintenance, and update their profile."
    },
    "payments": {
      "title": "Rent Tracking & Payments",
      "desc": "Track rent cycles (daily, monthly, yearly). Tenants submit payment proof for approval. Lease dates auto-update."
    },
    "maintenance": {
      "title": "Maintenance Requests",
      "desc": "Tenants submit maintenance requests with priority levels. You get notified and can track resolution progress."
    },
    "agreements": {
      "title": "Digital Agreements",
      "desc": "Create customizable tenancy agreement templates. E-sign with witnesses or upload signed PDFs for verification."
    },
    "notifications": {
      "title": "Smart Notifications",
      "desc": "Get notified on rent changes, quit notices, payment approvals, and document events. Email escalation for critical alerts."
    }
  },
  "HowItWorks": {
    "badge": "How It Works",
    "title": "Get started in three simple steps",
    "step1": {
      "title": "List Your Property",
      "desc": "Add your property details, set rent prices, configure units, and publish your listing — all in minutes."
    },
    "step2": {
      "title": "Invite Tenants",
      "desc": "Send automated invitations. Tenants create their own profiles, submit payments, and sign agreements digitally."
    },
    "step3": {
      "title": "Manage from One Dashboard",
      "desc": "Track rent collection, approve maintenance requests, verify signed documents, and get real-time notifications."
    }
  },
